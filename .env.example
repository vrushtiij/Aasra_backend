# Postgres connection string (Supabase or otherwise)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Firebase Admin SDK service-account credentials -- provide ONE of these:
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", ...}

# How many reminder repeats before a caregiver alert fires
REMINDER_REPEAT_LIMIT=3
